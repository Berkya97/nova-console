<UserControl x:Class="Nova.Views.OptionsMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Card" Width="560" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,120,0"
            CornerRadius="22" Background="#F2141A2A" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="12,26,12,14"
            Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="70" ShadowDepth="0" Opacity="0.65"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Shift" X="70"/>
        </Border.RenderTransform>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="19" Foreground="{StaticResource TextFaint}" Margin="22,0,22,16"
                       TextTrimming="CharacterEllipsis"/>
            <ItemsControl x:Name="List" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Bg" CornerRadius="14" Height="62" Padding="22,0" Margin="0,2" Background="Transparent" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="G" Text="{Binding Glyph}" Style="{StaticResource GlyphText}" FontSize="22" Width="30"/>
                                <TextBlock x:Name="L" Text="{Binding Label}" FontSize="22" Margin="18,0,0,2" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="White"/>
                                <Setter TargetName="G" Property="Foreground" Value="#0B0F1A"/>
                                <Setter TargetName="L" Property="Foreground" Value="#0B0F1A"/>
                                <Setter TargetName="L" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
