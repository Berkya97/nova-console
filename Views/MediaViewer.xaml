<UserControl x:Class="Nova.Views.MediaViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Black" Opacity="0">
    <Grid>
        <Image x:Name="Photo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                      Visibility="Collapsed"/>

        <!-- Müzik çalar görünümü -->
        <Grid x:Name="AudioView" Visibility="Collapsed">
            <Viewbox Stretch="UniformToFill">
                <Grid Width="1920" Height="1080">
                    <Rectangle x:Name="AudioGlow" Width="1700" Height="1300" Opacity="0.85"
                               RenderOptions.BitmapScalingMode="Linear" Fill="#FF1E3A8A">
                        <Rectangle.OpacityMask>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.OpacityMask>
                        <Rectangle.Effect>
                            <BlurEffect Radius="70" RenderingBias="Performance"/>
                        </Rectangle.Effect>
                    </Rectangle>
                </Grid>
            </Viewbox>
            <Viewbox>
                <Grid Width="1920" Height="1080">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-80,0,0">
                        <Grid Width="440" Height="440">
                            <Border CornerRadius="22" Background="#30FFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="60" ShadowDepth="10" Opacity="0.6"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock Text="&#xEC4F;" Style="{StaticResource GlyphText}" FontSize="150" Foreground="#80FFFFFF"/>
                            <Border CornerRadius="22">
                                <Border.Background>
                                    <ImageBrush x:Name="AudioArt" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" Margin="70,0,0,0" Width="760">
                            <TextBlock Text="Şimdi çalıyor" FontSize="20" Foreground="{StaticResource TextFaint}"/>
                            <TextBlock x:Name="AudioTitle" FontSize="54" FontWeight="SemiBold" TextWrapping="Wrap"
                                       MaxHeight="150" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                            <TextBlock x:Name="AudioSub" FontSize="24" Foreground="{StaticResource TextDim}" Margin="0,14,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- Üst/alt bilgi katmanı: gölgeler ekran kenarına kadar uzanır, yazılar ölçeklenir -->
        <Grid x:Name="Chrome" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B3000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.Row="2">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#D9000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Viewbox Grid.RowSpan="3">
            <Grid Width="1920" Height="1080">
                <StackPanel Margin="120,56,120,0" VerticalAlignment="Top">
                    <TextBlock x:Name="TitleText" FontSize="30" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="IndexText" FontSize="18" Foreground="{StaticResource TextDim}" Margin="0,6,0,0"/>
                </StackPanel>
                <Grid x:Name="ProgressPanel" VerticalAlignment="Bottom" Margin="120,0,120,118">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="Track" Height="6">
                        <Border CornerRadius="3" Background="#40FFFFFF"/>
                        <Border x:Name="ProgressFill" CornerRadius="3" Background="White" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <TextBlock x:Name="StateGlyph" Grid.Row="1" Style="{StaticResource GlyphText}" HorizontalAlignment="Left"
                               FontSize="20" Margin="0,18,0,0" Text="&#xE768;"/>
                    <TextBlock x:Name="TimeText" Grid.Row="1" HorizontalAlignment="Right" Margin="0,16,0,0" FontSize="19"/>
                </Grid>
            </Grid>
            </Viewbox>
        </Grid>

        <!-- Ortadaki oynat/duraklat işareti ve kısa bildirimler -->
        <Viewbox IsHitTestVisible="False">
            <Grid Width="1920" Height="1080">
                <Border x:Name="Flash" Width="150" Height="150" CornerRadius="75" Background="#99000000" Opacity="0">
                    <TextBlock x:Name="FlashGlyph" Style="{StaticResource GlyphText}" FontSize="60"/>
                </Border>
                <Border x:Name="Osd" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,70,0,0"
                        Padding="30,12" CornerRadius="26" Background="#C0101522" Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="OsdGlyph" Style="{StaticResource GlyphText}" FontSize="20"/>
                        <TextBlock x:Name="OsdText" FontSize="22" Margin="14,0,0,2"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
