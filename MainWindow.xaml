<Window x:Class="Nova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Nova.Views"
        Title="Nova" Width="1600" Height="900"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="Black" Foreground="White" FontFamily="{StaticResource UiFont}"
        RenderOptions.BitmapScalingMode="HighQuality"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
    <Grid x:Name="Root" ClipToBounds="True">

        <!-- Temel arka plan (tema rengi) -->
        <Rectangle x:Name="BaseBg">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.78,0.05" GradientOrigin="0.78,0.05" RadiusX="1.1" RadiusY="1.35">
                    <GradientStop Color="#FF173A80" Offset="0"/>
                    <GradientStop Color="#FF0B1B40" Offset="0.42"/>
                    <GradientStop Color="#FF040811" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Kullanıcının duvar kağıdı -->
        <Grid x:Name="WallpaperLayer" Visibility="Collapsed" IsHitTestVisible="False">
            <Image x:Name="WallpaperImg" Stretch="UniformToFill"/>
            <Rectangle Fill="#8C040811"/>
        </Grid>

        <!-- Seçili öğenin renginden ortam ışığı -->
        <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
            <Grid Width="1920" Height="1080">
                <Rectangle x:Name="GlowA" Opacity="0" Width="1700" Height="1300" HorizontalAlignment="Right"
                           VerticalAlignment="Top" Margin="0,-380,-420,0" RenderOptions.BitmapScalingMode="Linear">
                    <Rectangle.OpacityMask>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF000000" Offset="0"/>
                            <GradientStop Color="#80000000" Offset="0.45"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.OpacityMask>
                    <Rectangle.Effect>
                        <BlurEffect Radius="60" RenderingBias="Performance"/>
                    </Rectangle.Effect>
                </Rectangle>
                <Rectangle x:Name="GlowB" Opacity="0" Width="1700" Height="1300" HorizontalAlignment="Right"
                           VerticalAlignment="Top" Margin="0,-380,-420,0" RenderOptions.BitmapScalingMode="Linear">
                    <Rectangle.OpacityMask>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF000000" Offset="0"/>
                            <GradientStop Color="#80000000" Offset="0.45"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.OpacityMask>
                    <Rectangle.Effect>
                        <BlurEffect Radius="60" RenderingBias="Performance"/>
                    </Rectangle.Effect>
                </Rectangle>
            </Grid>
        </Viewbox>

        <!-- Oyun kapak sanatı (tam ekran) -->
        <Grid x:Name="HeroA" Opacity="0" IsHitTestVisible="False">
            <Image Stretch="UniformToFill"/>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E6050A16" Offset="0"/>
                        <GradientStop Color="#99050A16" Offset="0.4"/>
                        <GradientStop Color="#00050A16" Offset="0.8"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#99050A16" Offset="0"/>
                        <GradientStop Color="#00050A16" Offset="0.3"/>
                        <GradientStop Color="#00050A16" Offset="0.55"/>
                        <GradientStop Color="#F2050A16" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Grid x:Name="HeroB" Opacity="0" IsHitTestVisible="False">
            <Image Stretch="UniformToFill"/>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E6050A16" Offset="0"/>
                        <GradientStop Color="#99050A16" Offset="0.4"/>
                        <GradientStop Color="#00050A16" Offset="0.8"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#99050A16" Offset="0"/>
                        <GradientStop Color="#00050A16" Offset="0.3"/>
                        <GradientStop Color="#00050A16" Offset="0.55"/>
                        <GradientStop Color="#F2050A16" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Işık zerrecikleri -->
        <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
            <Grid Width="1920" Height="1080">
                <v:ParticleField x:Name="Particles"/>
            </Grid>
        </Viewbox>

        <!-- Ana sahne: 1920x1080 tasarlanıp her çözünürlüğe ölçeklenir -->
        <Viewbox Stretch="Uniform">
            <Grid x:Name="Stage" Width="1920" Height="1080" Opacity="0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="StageShift"/>
                </Grid.RenderTransform>

                <Grid x:Name="ContentHost"/>

                <!-- Üst çubuk -->
                <Grid VerticalAlignment="Top" Margin="120,38,120,0" Height="60">
                    <StackPanel x:Name="TabBar" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <Canvas x:Name="IndicatorCanvas">
                        <Border x:Name="TabIndicator" Height="3" CornerRadius="1.5" Background="White" Canvas.Top="52" Width="0">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>
                    </Canvas>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="WeatherText" FontSize="22" VerticalAlignment="Center" Margin="0,0,34,2"
                                   Foreground="{StaticResource TextDim}" FontFamily="Segoe UI Symbol, Segoe UI" Visibility="Collapsed"/>
                        <TextBlock x:Name="SearchBtn" Text="&#xE721;" Style="{StaticResource GlyphText}" FontSize="24"
                                   Margin="0,0,30,0" Cursor="Hand" Foreground="{StaticResource TextDim}" ToolTip="Ara"/>
                        <TextBlock x:Name="ControlBtn" Text="&#xE713;" Style="{StaticResource GlyphText}" FontSize="24"
                                   Margin="0,0,30,0" Cursor="Hand" Foreground="{StaticResource TextDim}" ToolTip="Kontrol Merkezi"/>
                        <Grid Width="46" Height="46">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF5B8CFF" Offset="0"/>
                                        <GradientStop Color="#FF8A4DFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Stroke="#80FFFFFF" StrokeThickness="2"/>
                            <TextBlock x:Name="AvatarText" FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                            <Ellipse x:Name="AvatarPhoto" Visibility="Collapsed" Stroke="#80FFFFFF" StrokeThickness="2"/>
                        </Grid>
                        <TextBlock x:Name="UserText" FontSize="20" VerticalAlignment="Center" Margin="14,0,0,2"
                                   Foreground="{StaticResource TextDim}"/>
                        <Rectangle Width="1" Height="28" Fill="#40FFFFFF" Margin="28,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ClockText" FontSize="28" VerticalAlignment="Center" Margin="0,0,0,2"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- Medya görüntüleyici katmanı -->
        <Grid x:Name="MediaHost"/>

        <!-- Menü katmanı -->
        <Grid x:Name="MenuHost" Visibility="Collapsed">
            <Rectangle x:Name="MenuScrim" Fill="#A6000000" Opacity="0"/>
            <Viewbox Stretch="Uniform">
                <Grid x:Name="MenuStage" Width="1920" Height="1080"/>
            </Viewbox>
        </Grid>

        <!-- Tuş ipuçları ve bildirimler (her şeyin üstünde) -->
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Grid Width="1920" Height="1080">
                <StackPanel x:Name="HintBar" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom" Margin="0,0,120,38" Opacity="0"/>
                <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,118,90,0" Width="480"/>
            </Grid>
        </Viewbox>

        <!-- Açılış animasyonu -->
        <Grid x:Name="Boot" Background="Black">
            <Viewbox>
                <Grid Width="1920" Height="1080">
                    <StackPanel x:Name="BootLogo" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Opacity="0" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,40">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="BootScale" ScaleX="0.8" ScaleY="0.8"/>
                        </StackPanel.RenderTransform>
                        <Grid Width="150" Height="150">
                            <Ellipse Margin="-90">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#663D7BFF" Offset="0"/>
                                        <GradientStop Color="#003D7BFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Stroke="White" StrokeThickness="2.5" Opacity="0.9">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#9CC2FF" BlurRadius="24" ShadowDepth="0" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="40" Height="40" Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#BFD7FF" BlurRadius="40" ShadowDepth="0" Opacity="1"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="Orbit"/>
                                </Grid.RenderTransform>
                                <Ellipse Width="14" Height="14" Fill="White" VerticalAlignment="Top" Margin="0,-6,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="White" BlurRadius="18" ShadowDepth="0" Opacity="1"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <TextBlock Text="N  O  V  A" FontSize="40" FontWeight="Light" HorizontalAlignment="Center"
                                   Margin="0,52,0,0" Foreground="#E6FFFFFF"/>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
